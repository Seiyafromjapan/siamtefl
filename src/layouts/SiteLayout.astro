---
import { createHash } from 'node:crypto';
import styles from '../styles.css?raw';
import app from '../app.js?raw';

const { page, content, schema } = Astro.props;
const currentNavSection = (() => {
  const sections = {
    start: ['/teach-english-thailand-no-experience/', '/teach-english-thailand-non-native-speaker/', '/teach-english-thailand-without-degree/', '/teaching-english-thailand-after-40/', '/thailand-teacher-visa-work-permit/'],
    jobs: ['/where-to-find-teaching-jobs-thailand/', '/teaching-agency-vs-direct-hire-thailand/', '/too-late-apply-teaching-jobs-thailand/', '/thailand-teaching-job-application-documents/', '/thailand-teaching-interview-demo-lesson/', '/cv-resume-teaching-jobs-thailand/', '/thailand-teaching-contract-checklist/', '/no-replies-teaching-jobs-thailand/', '/how-long-after-tefl-to-get-teaching-job-thailand/', '/english-teacher-working-hours-thailand/', '/teach-english-thailand-with-tattoos/'],
    tefl: ['/tefl-course-comparison-thailand/', '/do-you-need-tefl-to-teach-in-thailand/', '/how-to-choose-tefl-course-thailand/', '/120-hour-tefl-certificate-thailand/', '/celta-vs-tefl-thailand/', '/tefl-job-placement-guarantee-thailand/', '/120-hour-vs-level-5-tefl-thailand/', '/essential-tefl-review/', '/standard-vs-all-in/', '/tefl-bangkok-cost/', '/online-vs-in-person-tefl-thailand/', '/tefl-course-deposit-refund-thailand/', '/see-tefl-chiang-mai-review/', '/world-tesol-academy-review/', '/is-chiang-mai-a-good-place-to-get-tefl-certified/'],
    budget: ['/money-to-move-to-thailand-to-teach/', '/calculator/', '/first-time-english-teacher-salary-thailand/', '/can-you-live-in-bangkok-on-35000-baht-teaching-salary/', '/can-you-save-money-teaching-english-thailand/', '/english-teacher-housing-thailand/', '/thailand-teacher-school-holiday-pay/', '/move-to-thailand-before-finding-teaching-job/', '/teach-english-thailand-one-year/', '/teach-english-thailand-without-speaking-thai/', '/thailand-vs-vietnam-teaching-english/']
  };
  return Object.entries(sections).find(([, paths]) => paths.includes(page.path))?.[0] || null;
})();
const navCurrent = (section, exactPath) => page.path === exactPath ? 'page' : currentNavSection === section ? 'location' : undefined;
const appVersion = createHash('sha256').update(app).digest('hex').slice(0, 12);
const isArticle = page.schema?.['@type'] === 'Article'
  || page.schema?.['@graph']?.some((item) => item['@type'] === 'Article');
const articleSchema = isArticle
  ? (page.schema['@type'] === 'Article' ? page.schema : page.schema['@graph'].find((item) => item['@type'] === 'Article'))
  : null;
const articleMeta = articleSchema
  ? `<meta property="article:published_time" content="${articleSchema.datePublished || ''}">\n  <meta property="article:modified_time" content="${articleSchema.dateModified || ''}">`
  : '';
const canonical = `https://siamtefl.com${page.path}`;
const socialImage = `https://siamtefl.com${page.socialImage || '/images/adult-class-social.jpg'}`;
const socialImageAlt = (page.socialImageAlt || 'Generic classroom stock photo of an instructor and adult learners; not a verified TEFL or Essential TEFL training location.')
  .replaceAll('&', '&amp;').replaceAll('"', '&quot;');
const appLoader = `<script defer>const appBase=location.hostname.endsWith('github.io')?'/siamtefl':'';const appScript=document.createElement('script');appScript.src=appBase+'/assets/app.js?v=${appVersion}';appScript.defer=true;document.body.append(appScript)</script>`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#123d35">
  <meta name="description" content={page.description}>
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="p:domain_verify" content="62a9ccd130a8c03caa319b87a0aa39d2" />
  <meta property="og:type" content={isArticle ? 'article' : 'website'}>
  <Fragment set:html={articleMeta} />
  <meta property="og:site_name" content="SiamTEFL">
  <meta property="og:title" content={page.ogTitle || page.title}>
  <meta property="og:description" content={page.ogDescription || page.description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={socialImage}>
  <meta property="og:image:type" content={page.socialImageType || 'image/jpeg'}>
  <meta property="og:image:width" content={page.socialImageWidth || 1800}>
  <meta property="og:image:height" content={page.socialImageHeight || 1013}>
  <meta property="og:image:alt" content={socialImageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={socialImage}>
  <meta name="twitter:image:alt" content={socialImageAlt}>
  <meta name="twitter:title" content={page.title}>
  <meta name="twitter:description" content={page.description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://www.essentialtefl.com">
  <Fragment set:html={`<style>${styles}</style>`} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <title>{page.title}</title>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="nav-wrap"><a class="brand" href="/" aria-label="SiamTEFL home"><span class="brand-mark">S</span><span>SIAM<span class="brand-light">TEFL</span><small>THE THAILAND DECISION GUIDE</small></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="nav" aria-label="Open menu"><span></span><span></span></button><nav id="nav" class="nav-links" aria-label="Main navigation"><a href="/teach-english-thailand-no-experience/" aria-current={navCurrent('start', '/teach-english-thailand-no-experience/')}>Start Here</a><a href="/where-to-find-teaching-jobs-thailand/" aria-current={navCurrent('jobs', '/where-to-find-teaching-jobs-thailand/')}>Find a Job</a><a class="nav-course" href="/tefl-course-comparison-thailand/" aria-current={navCurrent('tefl', '/tefl-course-comparison-thailand/')}>Compare TEFL</a><a href={page.path === '/' ? '#life-budget' : '/money-to-move-to-thailand-to-teach/'} aria-current={navCurrent('budget', '/money-to-move-to-thailand-to-teach/')}>Life &amp; Budget</a><a class="nav-cta" href="/calculator/" aria-current={page.path === '/calculator/' ? 'page' : undefined}>Budget Calculator <span>↗</span></a></nav></div></header>
<main id="main"><Fragment set:html={content} /></main>
<footer class="site-footer"><div class="footer-grid"><div class="footer-brand"><a class="brand brand-footer" href="/"><span class="brand-mark">S</span><span>SIAM<span class="brand-light">TEFL</span><small>THE THAILAND DECISION GUIDE</small></span></a><p class="footer-note">Independent research for your next chapter in Thailand.</p><nav class="footer-social" aria-label="Official social media"><a href="https://x.com/siam_tefl" target="_blank" rel="noopener noreferrer">X (Twitter)</a><a href="https://jp.pinterest.com/siamtefl/" target="_blank" rel="noopener noreferrer">Pinterest</a></nav></div><div class="footer-group"><h2>Find teaching work</h2><a href="/teach-english-thailand-no-experience/">Start with eligibility</a><a href="/where-to-find-teaching-jobs-thailand/">Find teaching jobs</a><a href="/thailand-teaching-job-application-documents/">Prepare your application</a><a href="/thailand-teaching-interview-demo-lesson/">Prepare for interviews</a></div><div class="footer-group"><h2>Compare TEFL courses</h2><a href="/tefl-course-comparison-thailand/">Compare courses by format and location</a><a href="/do-you-need-tefl-to-teach-in-thailand/">Do you need TEFL?</a><a href="/how-to-choose-tefl-course-thailand/">Course selection guide</a><a href="/essential-tefl-review/">Essential TEFL review</a><a href="/see-tefl-chiang-mai-review/">SEE TEFL Chiang Mai review</a><a href="/world-tesol-academy-review/">World TESOL Academy review</a></div><div class="footer-group"><h2>Life &amp; Budget</h2><a href="/money-to-move-to-thailand-to-teach/">Plan your move and first-pay runway</a><a href="/calculator/">Budget calculator</a><a href="/first-time-english-teacher-salary-thailand/">Teacher salary guide</a><a href="/english-teacher-housing-thailand/">Teacher housing guide</a><a href="/english-teacher-working-hours-thailand/">Working hours guide</a><a href="/can-you-live-in-bangkok-on-35000-baht-teaching-salary/">Bangkok cost of living</a></div><div class="footer-group"><h2>About this guide</h2><a href="/about/">About SiamTEFL</a><a href="/methodology/">Research methodology</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy policy</a></div></div><div class="footer-bottom"><span>© 2026 SiamTEFL · Independent guide, independently operated.</span><span>Course details can change. Verify fees, dates and eligibility with the provider before booking.</span><button class="privacy-settings-link" id="privacy-settings" type="button">Privacy choices</button></div></footer>
<aside class="consent-banner" id="analytics-consent" role="region" aria-label="Privacy choices" hidden><div><strong>Choose whether to allow analytics</strong><p id="analytics-consent-status" aria-live="polite"></p><p>Optional Google Analytics helps us understand page visits and clicks to course details. It stays off unless you allow it. <a href="/privacy/">Privacy policy</a></p></div><div class="consent-actions"><button class="consent-decline" type="button" data-analytics-consent="denied">Decline</button><button class="consent-allow" type="button" data-analytics-consent="granted">Allow analytics</button></div></aside>
<Fragment set:html={appLoader} />
</body>
</html>

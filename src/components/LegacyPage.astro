---
import SiteLayout from '../layouts/SiteLayout.astro';
import { addBreadcrumbs, removeInternalStoryLabels, renderSavingsScenarioVisual } from '../lib/page-rendering.js';

const { page } = Astro.props;
const resolvedPage = {
  ...page,
  content: page.content.replaceAll('{{AFFILIATE}}', 'https://www.essentialtefl.com/?ref=suThaiJapan')
};
const enhanced = addBreadcrumbs({
  ...resolvedPage,
  content: removeInternalStoryLabels(renderSavingsScenarioVisual(resolvedPage))
});
---
<SiteLayout page={page} content={enhanced.content} schema={enhanced.schema} />
